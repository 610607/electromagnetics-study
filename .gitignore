# LaTeX build products (build.py and tools/check_chapter.py write here)
build/
*.aux
*.log
*.out
*.toc
*.cmp
*.synctex.gz

# Python
__pycache__/
*.pyc

# Fonts extracted from the system Noto CJK collection for matplotlib (regenerated automatically)
figsrc/.fontcache/

# Raster and SVG copies of the figures are regenerated by figsrc/build.py; the PDFs are kept
figures/*.png
figures/*.svg
figures_zh/*.png
figures_zh/*.svg

# JSON results written by numerics.py, concept_checks.py, extended_checks.py when run directly
/results.json
/concept_results.json
/extended_results.json
